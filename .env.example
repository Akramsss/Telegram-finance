# Copy this file to .env and fill it in. Never share .env with anyone.

# 1. From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Telegram user IDs allowed to use the bot, separated by commas (send /start to the bot to see yours).
# The FIRST one is the admin: they approve new users from Telegram, and SPREADSHEET_ID is their sheet.
# Other people can also tap "Request access" in the bot; you approve them with a button.
ALLOWED_USER_IDS=

# 2. Google service account key file (put the downloaded JSON in this folder)
GOOGLE_CREDENTIALS_FILE=service_account.json

# 3. The long ID in your sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
SPREADSHEET_ID=

# Optional: Claude API key for free-form messages (console.anthropic.com).
# Leave empty to use the built-in parser ("bread 1.20, milk 0.95").
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

TIMEZONE=Europe/Paris
DEFAULT_PAYMENT=Card

# Automatic messages
WEEKLY_REPORT=true
MONTHLY_REPORT=true
DAILY_REMINDER=true
DAILY_REMINDER_TIME=21:30
